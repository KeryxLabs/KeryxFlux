<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Global Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>keryxflux</ToolCommandName>
    <PackageId>KeryxFlux.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Keryx Labs</Authors>
    <Description>KeryxFlux CLI - validate and manage docket files</Description>
    <PackageTags>integration;cli;yaml</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cocona" Version="2.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeryxFlux.Domain\KeryxFlux.Domain.csproj" />
  </ItemGroup>

</Project>
