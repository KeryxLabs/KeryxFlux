{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  
  "Hangfire": {
    "WorkerCount": 10,
    "Queues": [
      "critical",
      "default",
      "normal",
      "low"
    ]
  }
}

