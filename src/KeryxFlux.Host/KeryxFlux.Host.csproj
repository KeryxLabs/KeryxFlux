<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeryxFlux.Application\KeryxFlux.Application.csproj" />
    <ProjectReference Include="..\KeryxFlux.Infrastructure\KeryxFlux.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy plugin DLL to output directory -->
  <Target Name="CopyPlugins" AfterTargets="Build">
    <ItemGroup>
      <PluginFiles Include="..\..\plugins\KeryxFlux.Plugins.SampleReceiver\bin\$(Configuration)\net8.0\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(OutputPath)plugins" />
  </Target>

</Project>

